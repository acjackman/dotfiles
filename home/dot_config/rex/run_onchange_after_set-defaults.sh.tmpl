{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
#
# Rex GUI settings. init.lua only covers keys (rex.bind/unbind/mode/on), so
# everything from the Settings window lives in this plist. Rex reads it at
# launch; quit and reopen Rex to pick up changes.

d=com.superlogical.rex

# Appearance
defaults write $d Workspace.appearance -string system
defaults write $d Workspace.darkThemeID -string merino-dark
defaults write $d Workspace.lightThemeID -string merino-light
defaults write $d Workspace.interfaceStyle -string useTheme
defaults write $d Workspace.usesPaneGlass -bool false
defaults write $d Workspace.usesStandardInactiveWindowPaneStyles -bool true
defaults write $d Workspace.inactivePaneFadeMode -string both
defaults write $d Workspace.tabIconTintMode -string off
defaults write $d Workspace.shellIconTheme -string default
defaults write $d Workspace.appIconVisibility -string dockAndMenuBar

# Layout
defaults write $d Workspace.tabStyle -string horizontal
defaults write $d Workspace.tabBarEdge -string top
defaults write $d Workspace.sidebarPosition -string left
defaults write $d Workspace.sidebarCollapsed -bool false
defaults write $d Workspace.sidebarShowsActivity -bool false
defaults write $d Workspace.sidebarSwipe -string swipe
defaults write $d Workspace.toolbarBehavior -string alwaysShow
defaults write $d Workspace.showsPaneHeaders -bool false
defaults write $d Workspace.paneHeaderVisibility -string never
defaults write $d Workspace.paneDensity -string compact
defaults write $d Workspace.notificationPosition -string bottom-center
defaults write $d Workspace.activityGrouping -string priority

# Terminal
defaults write $d Workspace.terminalFontPointSize -float 13.5
defaults write $d Workspace.terminalCursorStyle -string block
defaults write $d Workspace.terminalCursorBlinkUsesCustomInterval -bool false
defaults write $d Workspace.terminalCursorBlinkIntervalMilliseconds -int 500
defaults write $d Workspace.cursorShadersEnabled -bool true
defaults write $d Workspace.cursorShader -string warp
defaults write $d Workspace.terminalCopyOnSelect -bool true
defaults write $d Workspace.terminalImproveTextContrast -bool true
defaults write $d Workspace.terminalSmoothScrolling -bool true
defaults write $d Workspace.terminalUsesDisplayP3 -bool false

# Agents, SSH, server
defaults write $d Workspace.sshAgentChoice -string system
defaults write $d rex.agents.names-sessions -bool false
defaults write $d rex.server.automatic-restart-enabled -bool true
defaults write $d rex.server.block-plugin-reload-enabled -bool false

# Updates
defaults write $d SUEnableAutomaticChecks -bool true
defaults write $d SUAutomaticallyUpdate -bool true
{{ end -}}
