# rex-launch (nicosuave/rex-launch), the Rex composer on shift+cmd+n.
# It finds repos up to two levels under code_folders but skips any whose .git
# is a file, which is every bare-layout repo here (.git -> .bare). Those are
# listed below from ~/dev/*/*/.bare at apply time: re-apply after cloning one.
code_folders = ["~/dev"]
{{- range glob (joinPath .chezmoi.homeDir "dev/*/*/.bare") }}
{{- $root := dir . }}
{{- $main := joinPath $root "main" }}

[[project]]
name = {{ base $root | quote }}
path = {{ if stat $main }}{{ $main | quote }}{{ else }}{{ $root | quote }}{{ end }}
{{- end }}
