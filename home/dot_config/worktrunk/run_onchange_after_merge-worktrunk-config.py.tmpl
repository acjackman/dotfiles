#!/usr/bin/env python3
"""
Merge chezmoi-managed worktrunk settings with machine-local [projects] section.
"""
# hash: {{ include "dot_config/worktrunk/run_onchange_after_merge-worktrunk-config.py.tmpl" | sha256sum }}

from __future__ import annotations

import os
import re
import shutil
import subprocess
from pathlib import Path
from typing import Any

try:
    import tomllib
except ImportError:
    tomllib = None

try:
    import tomli
except ImportError:
    tomli = None

# Oldest wt the managed config below works with. Bump when the config starts
# relying on newer behaviour (0.81.0: hooks get context via template args,
# not stdin JSON).
MIN_WT_VERSION = (0, 81, 0)

def warn_if_wt_outdated() -> None:
    wt = shutil.which("wt")
    if wt is None:
        return
    try:
        out = subprocess.run([wt, "--version"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
    if not m:
        return
    installed = tuple(int(x) for x in m.groups())
    if installed < MIN_WT_VERSION:
        fmt = lambda v: ".".join(map(str, v))
        print(
            f"⚠ worktrunk {fmt(installed)} < {fmt(MIN_WT_VERSION)}; config may not work. "
            "Run: brew upgrade max-sixty/worktrunk/wt"
        )

def load_toml(path: Path) -> dict[str, Any]:
    data = path.read_bytes()
    if tomllib is not None:
        return tomllib.loads(data.decode("utf-8"))
    if tomli is not None:
        return tomli.loads(data.decode("utf-8"))
    raise RuntimeError("Reading TOML requires Python 3.11+ or the 'tomli' package.")

def format_toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return f'"{value}"'
    if isinstance(value, list):
        items = ", ".join(format_toml_value(v) for v in value)
        return f"[{items}]"
    if isinstance(value, dict):
        items = ", ".join(f"{k} = {format_toml_value(v)}" for k, v in value.items())
        return "{" + items + "}"
    return str(value)

def write_projects_section(projects: dict[str, Any]) -> str:
    if not projects:
        return "[projects]\n"

    lines = ["[projects]"]
    for key, value in projects.items():
        if isinstance(value, dict):
            lines.append(f'[projects."{key}"]')
            for k, v in value.items():
                lines.append(f"{k} = {format_toml_value(v)}")
        else:
            lines.append(f"{key} = {format_toml_value(value)}")
    return "\n".join(lines) + "\n"

def main() -> int:
    header_text = (
        "╔═══════════════════════════════════════════════════════════════════════════╗\n"
        "║  Worktrunk                                                                ║\n"
        "╚═══════════════════════════════════════════════════════════════════════════╝"
    )
    print(header_text)
    warn_if_wt_outdated()

    config_path = Path(os.path.expanduser("~/.config/worktrunk/config.toml"))

    # Extract existing [projects] section if file exists
    projects: dict[str, Any] = {}
    if config_path.exists():
        try:
            existing = load_toml(config_path)
            projects = existing.get("projects", {})
        except Exception as e:  # noqa: BLE001 - best-effort merge; warn and keep going
            print(f"Warning: could not parse existing config: {e}")

    # Chezmoi-managed settings (worktrunk template syntax preserved with raw strings)
    managed_config = """\
worktree-path = ".worktrees/{{ "{{" }} branch | sanitize {{ "}}" }}"
skip-shell-integration-prompt = true

[commit.generation]
command = "~/.config/worktrunk/wt-commit-generate"

[merge]
squash = false

[post-switch]
tmux = "[ -n \\"$TMUX_PANE\\" ] && [ $(tmux list-panes 2>/dev/null | wc -l) -eq 1 ] && { tmux rename-window -t \\"$TMUX_PANE\\" \\"$(~/.config/tmux/rename-from-repo.sh \\"$PWD\\")\\" 2>/dev/null || true; }"
claude-trust = "~/.config/worktrunk/hooks/ensure-claude-trust.sh"

[pre-remove]
tmux = "~/.config/worktrunk/hooks/wt-tmux-hook.sh {{ "{{" }} worktree_path {{ "}}" }} {{ "{{" }} primary_worktree_path {{ "}}" }}"
herdr = "~/.config/worktrunk/hooks/wt-herdr-hook.sh {{ "{{" }} worktree_path {{ "}}" }}"

[pre-merge]
tmux = "~/.config/worktrunk/hooks/wt-tmux-hook.sh {{ "{{" }} worktree_path {{ "}}" }} {{ "{{" }} primary_worktree_path {{ "}}" }}"
herdr = "~/.config/worktrunk/hooks/wt-herdr-hook.sh {{ "{{" }} worktree_path {{ "}}" }}"
"""

    # Project keys chezmoi once managed; strip them so a stale override isn't preserved.
    # dotfiles used to pin worktrees outside the repo; with .chezmoiroot = home,
    # the default .worktrees/ sits outside the chezmoi source and is safe.
    managed_project_keys = {"github.com/acjackman/dotfiles"}

    # Combine managed config with preserved local-only projects
    local_projects = {k: v for k, v in projects.items() if k not in managed_project_keys}
    config_path.parent.mkdir(parents=True, exist_ok=True)

    full_config = managed_config + "\n" + write_projects_section(local_projects)
    config_path.write_text(full_config)

    print(f"Wrote worktrunk config to {config_path}")
    if local_projects:
        print(f"Preserved {len(local_projects)} local project(s)")

    return 0

if __name__ == "__main__":
    raise SystemExit(main())
