#!/usr/bin/env bash
# Bring Rex to the front, the Rex analogue of herdr-reveal and
# activate-or-open-ghostty.sh. Rex.app is terminal and multiplexer client in
# one, so there is nothing to attach: just pick the session and raise the app.
#
#   rex-open                         focus Rex (launching it if needed)
#   rex-open --new-window            open another Rex window
#   rex-open TARGET [DIR]            show session TARGET (a label or session id),
#                                    creating it in DIR when no session matches
#
# Used by Hammerspoon, Tuna, ,linear-start and command-file-router.
set -euo pipefail

PATH="$HOME/.local/bin:$PATH"

die() { echo "rex-open: $*" >&2; exit 1; }

app_client_connected() {
  rex client ls 2>/dev/null | awk 'NR > 1 && $0 ~ / app / { found = 1 } END { exit !found }'
}

# Launch Rex if needed and wait for the app to connect to its server, since
# client actions (window.new, session.select) need a connected app.
ensure_app() {
  app_client_connected && return 0
  open -a Rex
  for _ in $(seq 1 40); do
    app_client_connected && return 0
    perl -e 'select(undef, undef, undef, 0.25)'
  done
  die "Rex.app did not connect to its server"
}

case "${1:-}" in
  "")
    open -a Rex
    exit 0
    ;;
  --new-window)
    if app_client_connected; then
      rex do client.window.new >/dev/null 2>&1 ||
        echo "rex-open: couldn't open a window (is Remote Control on?)" >&2
      open -a Rex
    else
      open -a Rex # a fresh launch opens a window by itself
    fi
    exit 0
    ;;
  -h | --help)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

target="$1"
dir="${2:-}"

session_id=$(rex ls --json | jq -r --arg t "$target" \
  'first(.sessions[] | select(.session_id == $t or .label == $t) | .session_id) // empty')

if [[ -z "$session_id" ]]; then
  [[ "$target" == session:* ]] && die "no session $target"
  session_id=$(rex new "$target" ${dir:+-c "$dir"} --json | jq -r .session_id)
  [[ -n "$session_id" ]] || die "could not create session $target"
fi

ensure_app
# Switching the app's session is a client action, which Rex.app only accepts
# with Remote Control on (Settings > Server > Client Info). Without it the
# session still exists; Rex just comes to the front on whatever it showed.
rex do session.select session_id="$session_id" >/dev/null 2>&1 ||
  echo "rex-open: couldn't switch Rex to $target (is Remote Control on?)" >&2
open -a Rex
