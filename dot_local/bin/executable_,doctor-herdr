#!/usr/bin/env bash
#
# ,doctor-herdr — reload a stale herdr keybinding table; detect a herdr
# client/server protocol mismatch.
#
# Two distinct upgrade-in-place failures, one cause: `brew upgrade` swaps the
# binary while the old server keeps running.
#
# 1. STALE KEYBINDINGS (fixed by default). The running server keeps serving its
#    old keybinding table, which can silently drop `[[keys.command]]` custom
#    commands — the keys just do nothing, with no log line, while every other
#    binding works. `herdr server reload-config` re-registers them. It costs
#    nothing and kills no panes, so this doctor runs it unconditionally.
#    Nothing triggers it otherwise: the `run_onchange` script in
#    dot_config/herdr/ only reloads when config.toml *changes*, and an upgrade
#    changes the binary, not the config.
#
# 2. PROTOCOL MISMATCH (reported, never fixed unprompted — see below).
#
# herdr's wire protocol churns pre-1.0. `brew upgrade` replaces the binary in
# place but leaves the already-running server on the OLD protocol, so every CLI
# call from the new binary is rejected:
#
#     client protocol 17 is newer than server protocol 16; restart the Herdr
#     server before using this command.
#
# The visible symptom is that *the plugins all stop working at once* — every
# herdr plugin (command-palette, worktrunk, muster, pluck, window-title-sync,
# vim-herdr-navigation) drives the `herdr` CLI, so they fail together while
# herdr itself keeps running normally. Agent surface control fails the same way,
# for the same reason. Nothing is corrupt; the server just needs a restart.
#
# UNLIKE the other ,doctor-* scripts, this one does NOT apply the mismatch fix
# by default. The only remedy is restarting the server, which kills every pane
# process — including long-running agents. Losing those unprompted is worse
# than the mismatch, so the restart is opt-in behind --restart. (The keybinding
# reload above is unaffected: it is non-destructive and always runs.)
#
# A mismatch also blocks the reload — the reload is itself a CLI call, so it is
# rejected too. Fix the mismatch first (--restart); a fresh server reads the
# current config anyway.
#
# Usage:
#   ,doctor-herdr             reload config; report health; exit 1 on mismatch
#   ,doctor-herdr --restart   stop the stale server (kills all pane processes)
#
# Exit codes: 0 healthy (or fixed), 1 mismatch found and not fixed.

set -euo pipefail

restart=0
for arg in "$@"; do
  case "$arg" in
    --restart) restart=1 ;;
    # Print the header block (line 2 through the last comment line before code).
    -h|--help) sed -n '2,/^# Exit codes/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf ',doctor-herdr: unknown argument: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr not installed — nothing to check."
  exit 0
fi

status="$(herdr status server 2>/dev/null || true)"
field() { sed -n "s/^$1: *//p" <<<"$status" | head -1; }

state="$(field status)"
if [[ "$state" != "running" ]]; then
  echo "herdr server not running — nothing to check."
  exit 0
fi

server_version="$(field version)"
server_proto="$(field protocol)"
compatible="$(field compatible)"
socket="$(field socket)"
client_version="$(herdr --version 2>/dev/null | awk '{print $2}')"

if [[ "$compatible" == "yes" ]]; then
  echo "herdr healthy — client ${client_version:-?} and server ${server_version:-?} both speak protocol ${server_proto:-?}."

  # Re-register keybindings in case the running server is serving a stale table
  # (see the header). Non-destructive and idempotent, so it runs every time —
  # there is no way to ask the server whether its table is current.
  echo "Reloading config (re-registers custom keybindings)…"
  if reload="$(herdr server reload-config 2>&1)"; then
    # herdr reports config problems as `diagnostics` in the reload response
    # rather than a non-zero exit, so surface a non-empty list.
    if [[ "$reload" == *'"diagnostics":[]'* ]]; then
      echo "  config reloaded — keybindings re-registered."
    else
      echo "  config reloaded WITH DIAGNOSTICS:"
      sed 's/^/    /' <<<"$reload"
    fi
  else
    echo "  reload failed:" >&2
    sed 's/^/    /' <<<"$reload" >&2
    exit 1
  fi
  exit 0
fi

cat <<EOF
herdr PROTOCOL MISMATCH — plugins and agent surface control will not work.

  installed binary: ${client_version:-?}
  running server:   ${server_version:-?} (protocol ${server_proto:-?})

The binary was upgraded while this server kept running. Restarting the server
clears it. Session layout is persisted and restores; pane PROCESSES do not.
EOF

# macOS `pgrep -f` is unreliable here (it misses the server but matches unrelated
# processes whose long argv merely mentions herdr), so match on ps output.
# (No early `exit` in awk: closing the pipe early SIGPIPEs ps, which pipefail
# then turns into a spurious failure.)
server_pid="$(ps -eo pid=,args= | awk '$0 ~ /herdr server$/ {print $1}' || true)"
server_pid="${server_pid%%$'\n'*}"
if [[ -n "$server_pid" ]]; then
  children="$(pgrep -P "$server_pid" 2>/dev/null || true)"
  if [[ -n "$children" ]]; then
    echo
    echo "Pane processes that a restart would kill (plus anything nested under them):"
    # shellcheck disable=SC2086 # word splitting is the point: pid list -> ps
    ps -o pid=,command= -p $(tr '\n' ' ' <<<"$children") 2>/dev/null | cut -c1-100 | sed 's/^/  /'
  fi
fi

if (( ! restart )); then
  cat <<EOF

Not restarting (this doctor never restarts unprompted). When the panes above
are safe to lose, re-run with:

  ,doctor-herdr --restart

then relaunch herdr (~/.config/herdr/ghostty-herdr).
EOF
  exit 1
fi

echo
echo "Stopping the stale server…"
HERDR_SOCKET_PATH="${socket:-$HOME/.config/herdr/herdr.sock}" herdr server stop
echo "Stopped. Relaunch herdr with ~/.config/herdr/ghostty-herdr"
