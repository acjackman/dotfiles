#!/usr/bin/env bash
# Topgrade step for Plannotator (dot_config/topgrade.toml.tmpl).
#
# 1. `plannotator update` reinstalls the binary with the saved install flags
#    (--minimal here, so no agent config is rewritten).
# 2. The running Inbox keeps executing the old binary until restarted; restart
#    it only when its version lags the CLI. The launchd supervisor
#    (plannotator-inbox-supervise) adopts the detached replacement.
# 3. The Claude Code plugin is versioned separately and --minimal doesn't
#    touch it: update it in every config dir that has it.
set -euo pipefail

command -v plannotator >/dev/null 2>&1 || exit 0

plannotator update

if [[ "$(plannotator inbox status --json 2>/dev/null | jq -r 'select(.running) | .version == .cli_version')" == false ]]; then
    echo "Restarting the Inbox onto the new binary"
    plannotator inbox restart
fi

command -v claude >/dev/null 2>&1 || exit 0
unset CLAUDECODE
for dir in "$HOME/.claude" "$HOME"/.config/claude/profiles/*/; do
    dir="${dir%/}"
    CLAUDE_CONFIG_DIR="$dir" claude plugin list 2>/dev/null | grep -q 'plannotator@plannotator' || continue
    echo "Updating Claude plugin in $dir"
    CLAUDE_CONFIG_DIR="$dir" claude plugin marketplace update plannotator >/dev/null
    CLAUDE_CONFIG_DIR="$dir" claude plugin update plannotator@plannotator --scope user
done
