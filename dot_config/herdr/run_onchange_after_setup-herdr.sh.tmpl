#!/usr/bin/env bash
# hash: {{ include "dot_config/herdr/modify_config.toml" | sha256sum }}
#
# Keep the herdr trial wired up: ensure the vim-herdr-navigation plugin is
# installed, then reload the running server's config after the keybindings in
# config.toml change. Guarded on herdr being present, so this is a clean no-op
# on machines that haven't opted into the trial (installed on personal machines
# by run_after_install-herdr.sh.tmpl).
set -euo pipefail

command -v herdr >/dev/null 2>&1 || exit 0

# Plugins to keep installed: "<plugin_id> <owner/repo>".
#   vim-herdr-navigation   — <C-h/j/k/l> between herdr panes and Neovim splits
#   acjackman.title-rename — tmux-style window title (`workspace | tab | ~/path`),
#                            which Timing attributes time from. Its tab/workspace
#                            renaming is off (plugins/config/…/config.toml) —
#                            herdr-bar names tabs. Own repo; `herdr plugin
#                            install` builds it with Cargo, so it needs the same
#                            Rust toolchain as muster below.
#   worktrunk              — worktree switch/create/remove via worktrunk (`wt`);
#                            needs wt >= 0.60, fzf, jq (already in the toolchain)
#   kichel.muster          — agent-aware project switcher (the sesh analogue);
#                            `herdr plugin install` COMPILES it from source, so it
#                            needs a Rust toolchain — provided by `brew "rust"` in
#                            Brewfile-base. Projects it offers are configured in
#                            plugins/config/kichel.muster/config.toml.
#   rmarganti.herdr-pluck  — tmux-fingers-style hint picker: copy a visible token
#                            with a keyboard hint (prefix+space). Ships prebuilt
#                            binaries for macOS Apple Silicon / Linux x86_64, else
#                            builds via Cargo (Rust already present). Copies with
#                            macOS `pbcopy` (built in).
#   jt.command-palette     — fzf command palette (prefix+p): fuzzy-pick any action
#                            exposed by any installed plugin. Pure bash + fzf + jq
#                            (already in the toolchain), so no build toolchain
#                            needed; runs the picker in an overlay pane so fzf
#                            gets a TTY.
#   drovr                  — move the focused pane into any tab, or the whole tab
#                            to another workspace, from an fzf popup; relocates
#                            live panes (`herdr pane move`), so agents survive.
#                            Runs .ts directly via node type stripping (upstream
#                            asks for node >= 23) + fzf; no build step. Installed
#                            from the applifaction fork: upstream (AVGVSTVS96)
#                            focuses the destination *after* the move, but herdr
#                            closes the picker popup once the source tab empties,
#                            so focus never followed tab moves. The fork folds
#                            `--focus` into the final move. Upstream has merged
#                            no outside PRs and went quiet in 2026-08.
#   hhdebb.herdr-radar     — readable Agents sidebar (vendor logos, activity
#                            grouping, stale rows dimmed) + an icon font. Node
#                            18+. Co-owns herdr's config.toml and ghostty's
#                            config via marker-fenced blocks — see CLAUDE.md.
#   herdr-bar              — Cmd+K-style fuzzy switcher over agents/tabs/panes
#                            (prefix+k), plus automatic task titles for unnamed
#                            tabs. Python 3 stdlib only; no build step.
#   heeler                 — Odin only: pairs the Heeler iOS app for remote
#                            access over SSH and pushes agent notifications.
#                            Node 20+; needs macOS Remote Login on. Lives in a
#                            repo subdirectory on `main`, hence the extra args.
#                            Pair with `herdr plugin action invoke heeler.pair`.
#
# Entry format: "<plugin_id> <source> [extra install args…]".
plugins=(
  "vim-herdr-navigation paulbkim-dev/vim-herdr-navigation"
  "acjackman.title-rename acjackman/herdr-title-rename"
  "worktrunk devashish2203/herdr-worktrunk"
  "kichel.muster marcoskichel/herdr-muster"
  "rmarganti.herdr-pluck rmarganti/herdr-pluck"
  "jt.command-palette JanTvrdik/herdr-command-palette"
  "drovr applifaction/herdr-drovr"
  "hhdebb.herdr-radar hhdebb/herdr-radar"
  "herdr-bar jeffarese/herdr-bar"
{{- if eq .hostname "Odin" }}
  "heeler ZingerLittleBee/Heeler/plugin --ref main"
{{- end }}
)

# A stale server (binary upgraded without a restart) rejects every CLI call with
# a protocol_mismatch. Bail out loudly rather than reading that as "no plugins
# installed" and trying to reinstall all of them — see `,doctor-herdr`.
if ! installed="$(herdr plugin list 2>&1)"; then
  if grep -q 'protocol_mismatch' <<<"$installed"; then
    echo "herdr server protocol is stale — skipping plugin setup." >&2
    echo "Run \`,doctor-herdr\` to fix, then re-apply." >&2
    exit 0
  fi
  # Any other failure (e.g. no server yet on a fresh machine): fall through with
  # an empty list so the plugins below still get installed.
  installed=""
fi

# Superseded plugins. Only one plugin can own the outer window title — two of
# them fight over `client.window_title.set`, each with its own dedupe state, and
# the title flaps. acjackman.title-rename replaced rjyo.window-title-sync, so
# remove the old one rather than leaving it installed-but-conflicting.
if grep -q 'rjyo.window-title-sync' <<<"$installed"; then
  echo "Removing rjyo.window-title-sync (superseded by acjackman.title-rename)…"
  herdr plugin uninstall rjyo.window-title-sync || \
    echo "warning: failed to uninstall rjyo.window-title-sync" >&2
fi

# acjackman.title-rename runs title-only (renaming is off in its config.toml),
# but an earlier version of this script disabled it outright — re-enable it.
if grep -q 'acjackman.title-rename.*disabled' <<<"$installed"; then
  echo "Re-enabling acjackman.title-rename (title sync only)…"
  herdr plugin enable acjackman.title-rename >/dev/null || \
    echo "warning: failed to enable acjackman.title-rename" >&2
fi

for entry in "${plugins[@]}"; do
  read -r id repo args <<<"$entry"
  # Installed from a different repo (e.g. switched to a fork under the same
  # plugin id): uninstall so the install below picks up the new source.
  # `herdr plugin list` shows the source as `[github:<owner/repo>@<sha>]`.
  # Match the `- <id> (` entry line, not a bare id: the id also appears in
  # each entry's `config:` path line.
  line="$(grep -F -- "- $id (" <<<"$installed" || true)"
  if [[ -n "$line" ]] && ! grep -qiF "github:$repo@" <<<"$line"; then
    echo "Switching ${id} plugin to ${repo}…"
    if herdr plugin uninstall "$id"; then
      line=""
    else
      echo "warning: failed to uninstall $id" >&2
    fi
  fi
  if [[ -z "$line" ]]; then
    echo "Installing $id plugin…"
    # Non-fatal: one plugin failing to build shouldn't abort the rest (set -e).
    # $args is intentionally unquoted: it word-splits into extra flags.
    # shellcheck disable=SC2086
    herdr plugin install "$repo" $args --yes || echo "warning: failed to install $id" >&2
  fi
done

# Reload config in the running server; harmless no-op when none is up.
if herdr server reload-config >/dev/null 2>&1; then
  echo "herdr config reloaded"
fi
