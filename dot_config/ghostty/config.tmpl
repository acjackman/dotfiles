# Relode config with cmd + shift + ,
# reference
# https://ghostty.org/docs/config/reference#initial-command
#

font-family = "IosevkaTerm Nerd Font Mono"
font-style = "Regular"

font-size = 15

theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# Shift enter as newline in claude code
keybind = shift+enter=text:\x1b\r

# Ignore Cmd+N so Hammerspoon can intercept it for sesh picker
keybind = super+n=ignore
keybind = super+t=ignore

keybind = global:super+alt+ctrl+shift+grave_accent=toggle_quick_terminal

window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

confirm-close-surface = true
wait-after-command = false
abnormal-command-exit-runtime = 2000

# >>> herdr-radar font block
font-codepoint-map = U+E1A0-U+E1BA=Herdr Agent Icons Max
font-codepoint-map = U+E1C0-U+E1C5=Herdr Agent Icons Max
# <<< herdr-radar font block
