# Based on https://github.com/iloveitaly/dotfiles/tree/master

# =============
# Powerlevel10k instant prompt
# =============
# Renders a prompt from cache before the rest of this file runs. Must stay at
# the top; anything that prints to the console before p10k loads would break it
# ("quiet" suppresses those warnings rather than the prompt).
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

{{ if eq .chezmoi.os "darwin" -}}
# Ensure login-shell PATH is available in interactive non-login shells (e.g. Tuna)
[[ -o login ]] || source ~/.zprofile
{{ end -}}
# =============
# Homebrew Settings
# =============

# See https://docs.brew.sh/Manpage#environment
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_BUNDLE_FILE_GLOBAL="${XDG_CONFIG_HOME:-${HOME}/.config}/homebrew/Brewfile-machine"

# avoid installation via brew, this is not a supported installation method and breaks
# some directory structure assumptions that exist across the plugin ecosystem.
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"

# Single shared compdump; -C keeps any zicompinit call cheap (see Completion below)
typeset -gA ZINIT
ZINIT[ZCOMPDUMP_PATH]="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
ZINIT[COMPINIT_OPTS]="-C"

source "${ZINIT_HOME}/zinit.zsh"

# unalias zi for zoxide later
unalias zi

# =============
# Functions & completion paths
# =============
# fpath must be complete before compinit runs

# Autoload personal functions
function load_funcs() {
    # via https://stackoverflow.com/a/63661686
    local funcs="$1"

    if [[ -d $funcs ]]; then
        # add our local functions dir to the fpath
        # FPATH is already tied to fpath, but this adds
        # a uniqueness constraint to prevent duplicate entries
        typeset -TUg +x FPATH=$funcs:$FPATH fpath

        local names=(${=$(ls -1 "$funcs" | sed -E "/^_/d")})

        # Now autoload them
        if [ "${#names[@]}" -gt 0 ]; then
            autoload $names
        fi
    fi
}
load_funcs "${XDG_CONFIG_HOME:-${HOME}/.config}/zsh/functions"
load_funcs "${XDG_CONFIG_HOME:-${HOME}/.config}/zsh/functions_local"
unset -f load_funcs

# Place any completions here
COMPLETIONS_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/zsh/completions"
fpath+="${COMPLETIONS_DIR}"

# =============
# Completion init
# =============
# compinit runs exactly once, here, before anything that might call compdef.
# mise >= 2026.9.2 injects its own full `compinit -i` from `mise activate`
# when compdef is undefined, and zinit's zicompinit atinits used to run two
# more -- three full rebuilds (~300ms each) rewriting the dump every shell.
# Plugin completions are symlinked into zinit's completions dir (already in
# fpath) and compdefs queued during zinit loads are replayed by zicdreplay.
#
# -C trusts the dump; it is rebuilt when missing or older than a day.
# Force a rebuild any time with `,zsh-cleanup-completions` (also run by
# topgrade, ,doctor-zsh, and the chezmoi run_onchange hooks for zsh and mise).
autoload -Uz compinit
() {
  setopt local_options extended_glob
  local dump="${ZINIT[ZCOMPDUMP_PATH]}"
  [[ -d "${dump:h}" ]] || mkdir -p "${dump:h}"
  if [[ -s "$dump" && -z "$dump"(#qN.mh+24) ]]; then
    compinit -C -d "$dump"
  else
    compinit -i -d "$dump"
  fi
  # compiled dump loads faster than parsing the text form
  if [[ ! -s "$dump.zwc" || "$dump" -nt "$dump.zwc" ]]; then
    zcompile "$dump"
  fi
}


# Mise for pinned binaries, env vars, and tasks
zinit as="command" lucid from="gh-r" for \
    id-as="usage" \
    atpull="%atclone" \
    jdx/usage

zinit as="command" lucid from="gh-r" for \
    id-as="mise" mv="mise* -> mise" \
    atclone="./mise* completion zsh > _mise" \
    atpull="%atclone" \
    atload='eval "$(mise activate zsh)"' \
    jdx/mise

autoload -Uz add-zsh-hook

# =============
# ENV Vairables & App Settings
# =============

export SPACECTL_SKIP_STACK_PROMPT='true'

export NOTI_DEFAULT="slack"

# =============
# Agent early return
# =============

# Skip zsh config for agent mode
if [[ "$PAGER" == "head -n 10000 | cat" || "$COMPOSER_NO_INTERACTION" == "1" ]]; then
  return
fi

# =============
# Completion
# =============

# forces zsh to realize new commands
zstyle ':completion:*' completer _oldlist _expand _complete _match _ignored _approximate

# matches case insensitive for lowercase
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# pasting with tabs doesn't perform completion
zstyle ':completion:*' insert-tab pending

# rehash if command not found (possibly recently installed)
zstyle ':completion:*' rehash true

# speed https://coderwall.com/p/9fksra/speed-up-your-zsh-completions
zstyle ':completion:*' accept-exact '*(N)'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# =============
# fzf-tab config
# =============

# set descriptions format to enable group support
zstyle ':completion:*:descriptions' format '[%d]'

# set list-colors to enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# preview directory's content with exa when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'exa -1 --color=always $realpath'

# switch group using `,` and `.`
zstyle ':fzf-tab:*' switch-group ',' '.'

# menu if nb items > 2
zstyle ':completion:*' menu select=2

# preview directory's content with exa when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'

# wtpr completion: show PR details in preview, use wtprd to include drafts
zstyle ':fzf-tab:complete:wtpr:*' fzf-preview 'gh pr view ${word%:*} 2>/dev/null'
zstyle ':fzf-tab:complete:wtpr:*' fzf-flags '--header="Tip: use wtprd instead to include draft PRs"'
zstyle ':fzf-tab:complete:wtprd:*' fzf-preview 'gh pr view ${word%:*} 2>/dev/null'
zstyle ':fzf-tab:complete:wtprd:*' fzf-flags '--header="Including draft PRs"'

# ,t completion: show sesh session preview
zstyle ':fzf-tab:complete:,t:*' fzf-preview 'sesh preview {} 2>/dev/null'

# don't show fzf unless there are more than 4 items
# zstyle ':fzf-tab:*' ignore false 4

# =============
# Shell Options
# man: zshoptions
# =============

setopt interactive_comments
setopt prompt_subst
setopt extended_glob            # Allow extended matchers like ^file, etc
setopt long_list_jobs
setopt auto_cd
setopt menu_complete            # Auto pick a menu match

# Set history behavior
# setopt share_history            # Share history across session
# setopt inc_append_history       # Dont overwrite history, add new entries immediately
setopt nosharehistory
setopt noincappendhistory
setopt extended_history         # Also record time and duration of commands.
setopt hist_expire_dups_first   # Clear duplicates when trimming internal hist.
setopt hist_find_no_dups        # Dont display duplicates during searches.
setopt hist_ignore_dups         # Ignore consecutive duplicates.
setopt hist_ignore_space        # Ignore commands prefixed with space
setopt hist_reduce_blanks       # Remove superfluous blanks.
setopt hist_save_no_dups        # Omit older commands in favor of newer ones.

# =============
# Interactive Sesttings
# =============
# without this some CLI tools (gh cli, for instance) do not page contents
export PAGER=less

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -FX"

# more powerful less config
# https://www.topbug.net/blog/2016/09/27/make-gnu-less-more-powerful/
export LESS='--quit-if-one-screen --ignore-case --status-column --LONG-PROMPT --RAW-CONTROL-CHARS --HILITE-UNREAD --tabs=4 --window=-4'

