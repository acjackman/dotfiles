[[comboMode.bindings]]
key = 'u'
label = 'UI Tweaks'

    [comboMode.bindings.destination]
    type = 'group'

        [[comboMode.bindings.destination.bindings]]
        key = 'p'
        label = 'Toggle DeskPad'

            [comboMode.bindings.destination.bindings.destination]
            type = 'command'

                [comboMode.bindings.destination.bindings.destination.command]
                actionIdentifier = 'tuna.common-actions/run-text-as-shell-command'
                behavior = 'run'
                presentation = 'automatic'
                subjectIdentifiers = [
                    "text:osascript -e 'if application \"DeskPad\" is running then' -e 'quit app \"DeskPad\"' -e 'else' -e 'tell application \"DeskPad\" to activate' -e 'end if'"
                ]
                type = 'savedCommand'

        [[comboMode.bindings.destination.bindings]]
        key = 'w'
        label = 'Rotate Wallpapers'

            [comboMode.bindings.destination.bindings.destination]
            type = 'url'

                [comboMode.bindings.destination.bindings.destination.url]
                relative = 'hammerspoon://rotate-wallpapers'

        [[comboMode.bindings.destination.bindings]]
        key = 'd'
        label = 'Toggle Dark Mode'

            [comboMode.bindings.destination.bindings.destination]
            type = 'command'

                [comboMode.bindings.destination.bindings.destination.command]
                actionIdentifier = 'tuna.common-actions/run-text-as-shell-command'
                behavior = 'run'
                presentation = 'automatic'
                subjectIdentifiers = [
                    "text:osascript -e 'tell app \"System Events\" to tell appearance preferences to set dark mode to not dark mode'"
                ]
                type = 'savedCommand'

        [[comboMode.bindings.destination.bindings]]
        key = 'h'
        label = 'HazeOver'

            [comboMode.bindings.destination.bindings.destination]
            type = 'group'

                [[comboMode.bindings.destination.bindings.destination.bindings]]
                key = 'h'
                label = 'Toggle'

                    [comboMode.bindings.destination.bindings.destination.bindings.destination]
                    type = 'command'

                        [comboMode.bindings.destination.bindings.destination.bindings.destination.command]
                        actionIdentifier = 'tuna.common-actions/run-text-as-shell-command'
                        behavior = 'run'
                        presentation = 'automatic'
                        subjectIdentifiers = [ "text:osascript -e 'tell app \"HazeOver\" to set enabled to not enabled'" ]
                        type = 'savedCommand'

                [[comboMode.bindings.destination.bindings.destination.bindings]]
                key = '='
                label = 'Increase Opacity'

                    [comboMode.bindings.destination.bindings.destination.bindings.destination]
                    type = 'command'

                        [comboMode.bindings.destination.bindings.destination.bindings.destination.command]
                        actionIdentifier = 'tuna.common-actions/run-text-as-shell-command'
                        behavior = 'run'
                        presentation = 'automatic'
                        subjectIdentifiers = [ "text:osascript -e 'tell app \"HazeOver\" to set intensity to (intensity + 10)'" ]
                        type = 'savedCommand'

                [[comboMode.bindings.destination.bindings.destination.bindings]]
                key = '-'
                label = 'Decrease Opacity'

                    [comboMode.bindings.destination.bindings.destination.bindings.destination]
                    type = 'command'

                        [comboMode.bindings.destination.bindings.destination.bindings.destination.command]
                        actionIdentifier = 'tuna.common-actions/run-text-as-shell-command'
                        behavior = 'run'
                        presentation = 'automatic'
                        subjectIdentifiers = [ "text:osascript -e 'tell app \"HazeOver\" to set intensity to (intensity - 10)'" ]
                        type = 'savedCommand'

        [[comboMode.bindings.destination.bindings]]
        key = 's'
