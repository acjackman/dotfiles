#!/usr/bin/env bash
set -euo pipefail

# Create or reuse a worktree for a branch, printing a JSON line {branch, path}.
# Fails closed: exits non-zero (nothing on stdout) unless the path is an existing directory.
# Creates a .tmp directory in the worktree for prompt files.
# Usage: setup-worktree.sh <branch-name> [--base <ref>] [--repo <path>]
#
# --repo <path>  Target a different git repo. If it's a bare repo managed by
#                worktrunk, worktrees are created there via `wt -C`. If it's a
#                regular checkout, no worktree is created — the agent runs
#                directly in that directory.

WT=/opt/homebrew/bin/wt

ensure_trust() {
    # Delegate to the shared worktrunk hook script.
    (cd "$1" && "$HOME/.config/worktrunk/hooks/ensure-claude-trust.sh" >&2) ||
        die "ensure-claude-trust failed for $1"
}

usage() {
    echo "Usage: setup-worktree.sh <branch-name> [--base <ref>] [--repo <path>]" >&2
    exit 1
}

[[ $# -lt 1 ]] && usage

branch="$1"
shift

base=""
repo=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --base)
            [[ $# -lt 2 ]] && usage
            base="$2"
            shift 2
            ;;
        --repo)
            [[ $# -lt 2 ]] && usage
            repo="$(cd "$2" && pwd)"
            shift 2
            ;;
        *)
            usage
            ;;
    esac
done

# Build the wt command — prefix with -C when targeting another repo
wt_cmd=("$WT")
[[ -n "$repo" ]] && wt_cmd+=(-C "$repo")

git_cmd=(git -C "${repo:-.}")

die() {
    echo "setup-worktree: $*" >&2
    exit 1
}

# Look up a branch's worktree path from `git worktree list --porcelain`.
# Instant and stable, unlike `wt list --format=json` (schema changed in
# worktrunk v0.77, and it collects status for every worktree: minutes in big repos).
worktree_path_for() {
    # Capture first, then parse: piping straight into an awk that `exit`s early
    # SIGPIPEs git on big repos (141 under pipefail).
    local listing
    listing=$("${git_cmd[@]}" worktree list --porcelain) || die "git worktree list failed in ${repo:-$PWD}"
    awk -v ref="refs/heads/$1" '
        /^worktree / { path = substr($0, 10) }
        $0 == "branch " ref { print path }
    ' <<<"$listing" | head -n1 || true
}

# Default branch name: origin/HEAD, else origin/main|master, else the bare
# repo's HEAD. Empty if undeterminable.
default_branch() {
    local ref b
    ref=$("${git_cmd[@]}" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || ref=""
    if [[ -n "$ref" ]]; then
        echo "${ref#refs/remotes/origin/}"
        return
    fi
    for b in main master; do
        if "${git_cmd[@]}" show-ref --verify --quiet "refs/remotes/origin/$b" ||
            "${git_cmd[@]}" show-ref --verify --quiet "refs/heads/$b"; then
            echo "$b"
            return
        fi
    done
    if [[ "$("${git_cmd[@]}" rev-parse --is-bare-repository 2>/dev/null)" == true ]]; then
        "${git_cmd[@]}" symbolic-ref --quiet --short HEAD 2>/dev/null || true
    fi
}

# Fetch origin's default branch and echo origin/<default> if it's usable, so new
# worktrees don't start on a stale local ref. Offline/no-origin: warn, echo nothing.
fresh_default_base() {
    local def
    def=$(default_branch)
    [[ -n "$def" ]] || return 0
    "${git_cmd[@]}" remote get-url origin &>/dev/null || return 0
    if ! "${git_cmd[@]}" fetch --quiet origin "+refs/heads/$def:refs/remotes/origin/$def" >&2; then
        echo "setup-worktree: warning: fetch origin/$def failed; using local base" >&2
        return 0
    fi
    echo "origin/$def"
}

emit() {
    local path="$1"
    [[ -n "$path" ]] || die "no worktree path resolved for '$branch'"
    [[ -d "$path" ]] || die "worktree path for '$branch' is not a directory: $path"
    jq -cn --arg b "$branch" --arg p "$path" '{branch: $b, path: $p}'
}

# When --repo is set and it isn't a git repo, treat it as a plain directory and
# skip worktree creation entirely.
if [[ -n "$repo" ]] && ! "${git_cmd[@]}" rev-parse --git-dir &>/dev/null; then
    [[ -d "$repo" ]] || die "repo is not a directory: $repo"
    mkdir -p "$repo/.tmp"
    ensure_trust "$repo"
    current_branch=$(git -C "$repo" branch --show-current 2>/dev/null || echo "HEAD")
    jq -cn --arg b "${current_branch:-HEAD}" --arg p "$repo" '{branch: $b, path: $p}'
    exit 0
fi

existing_path=$(worktree_path_for "$branch")

if [[ -n "$existing_path" ]]; then
    worktree_path="$existing_path"
    [[ -d "$worktree_path" ]] || die "worktree for '$branch' is registered at $worktree_path but the directory is missing (try: git worktree prune)"

    if [[ -n "$base" ]]; then
        head_commit=$(git -C "$worktree_path" rev-parse HEAD)
        base_commit=$(git -C "$worktree_path" rev-parse "$base")

        if [[ "$head_commit" != "$base_commit" ]] && ! git -C "$worktree_path" merge-base --is-ancestor "$head_commit" "$base_commit"; then
            echo "Error: existing worktree for '$branch' at $worktree_path is not compatible with --base $base" >&2
            echo "  worktree HEAD: $head_commit" >&2
            echo "  base ref:      $base_commit ($base)" >&2
            echo "  HEAD is not an ancestor of base; cannot fast-forward." >&2
            exit 1
        fi
    fi
else
    [[ -n "$base" ]] || base=$(fresh_default_base)
    create_args=(switch --no-cd --create "$branch")
    [[ -n "$base" ]] && create_args+=(--base "$base")

    # stdin from /dev/null so hooks never block/consume the caller's stdin
    TMUX_PANE= "${wt_cmd[@]}" "${create_args[@]}" >&2 </dev/null ||
        die "wt switch --create failed for '$branch' (see output above)"

    worktree_path=$(worktree_path_for "$branch")
fi

[[ -n "$worktree_path" && -d "$worktree_path" ]] || die "could not resolve a worktree directory for '$branch' (got: '${worktree_path:-}')"
mkdir -p "$worktree_path/.tmp"
ensure_trust "$worktree_path"
emit "$worktree_path"
