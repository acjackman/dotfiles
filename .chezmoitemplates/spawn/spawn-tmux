#!/usr/bin/env bash
set -euo pipefail

# spawn-tmux — open a Claude work-agent in a tmux window or session.
#
# Self-contained as of 2026-08-04: this used to delegate to the `clank`
# substrate adapter, which has been removed. Agents drive herdr or tmux
# directly now; this script stays as the hand-typed tmux CLI.
#
# The herdr side of that, inline (agents carry this, they don't look it up):
#   enumerate  herdr agent list        # join workspace_id -> `herdr workspace list` for labels
#   inspect    herdr agent get <pane_id>
#   spawn      herdr workspace create --cwd <worktree> --label <l> --no-focus
#              herdr pane run <pane> "unset TMUX TMUX_PANE; cat <brief> | claude \
#                --permission-mode=auto --name <l> \
#                --settings '{\"enableAllProjectMcpServers\":true}' --model <m>"
#   teardown   herdr workspace close <workspace_id>
# Identity is the workspace_id, re-resolved at use — never the label (labels are
# not unique; an ambiguous label is a stop-and-ask, not a guess). tmux is the
# direct fallback, with buffer-scraping instead of semantic agent state.
# If herdr misbehaves, or a command doesn't match the above, `herdr --skill`
# prints the binary's own agent guide — versioned with the binary, and the
# place to start debugging.
#
# Usage: spawn-tmux --window|--session --name <name> --dir <path> --prompt <file> [--model <model>]

usage() {
    echo "Usage: spawn-tmux --window|--session --name <name> --dir <path> --prompt <file> [--model <model>]" >&2
    exit 1
}

mode="" name="" dir="" prompt="" model=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --window)  mode="window";  shift ;;
        --session) mode="session"; shift ;;
        --name)    name="$2";      shift 2 ;;
        --dir)     dir="$2";       shift 2 ;;
        --prompt)  prompt="$2";    shift 2 ;;
        --model)   model="$2";     shift 2 ;;
        *) usage ;;
    esac
done

[[ -z "$mode" || -z "$name" || -z "$dir" || -z "$prompt" ]] && usage
[[ -f "$prompt" ]] || { echo "spawn-tmux: prompt file '$prompt' does not exist" >&2; exit 1; }
command -v tmux >/dev/null 2>&1 || { echo "spawn-tmux: tmux is not installed" >&2; exit 1; }
dir=$(cd "$dir" && pwd)

sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# --name is the tracking label: the tmux window/session name, the @agent_label
# pane option, and `claude --name` all use it, so the three identifiers line up
# and a human can find or resume the agent by one name.
#
# enableAllProjectMcpServers stops an autonomous agent stalling on the "N new
# MCP servers found — enable?" prompt for an unapproved project .mcp.json. It
# auto-approves project-scoped servers only, leaving global/user MCP intact.
# Override with SPAWN_MCP_SETTINGS='' to restore the interactive prompt.
launch="cat $(sq "$prompt") | claude --permission-mode=auto --name $(sq "$name")"
mcp_settings=${SPAWN_MCP_SETTINGS-'{"enableAllProjectMcpServers":true}'}
[[ -n "$mcp_settings" ]] && launch+=" --settings $(sq "$mcp_settings")"
[[ -n "$model" ]] && launch+=" --model $(sq "$model")"

if [[ "$mode" == "session" ]]; then
    pane_id=$(tmux new-session -d -s "$name" -c "$dir" -P -F '#{pane_id}')
else
    # Background window, matching spawn's historical behaviour.
    pane_id=$(tmux new-window -n "$name" -c "$dir" -d -P -F '#{pane_id}')
fi

tmux set-option -t "$pane_id" automatic-rename off >/dev/null 2>&1 || true
# -p scopes this to the pane; without it it becomes a session option that leaks
# onto every other pane in the session.
tmux set-option -p -t "$pane_id" @agent_label "$name" >/dev/null 2>&1 || true
tmux send-keys -t "$pane_id" "$launch" Enter

printf 'substrate: tmux\nlabel: %s\nhandle: %s\npane_id: %s\n' "$name" "$name" "$pane_id"
