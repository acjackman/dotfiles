{{- /*
  Single source of truth for user-level MCP servers. Consumed twice:
    - dot_claude/mcp-servers.json.tmpl  -> ~/.claude/mcp-servers.json (readable record)
    - dot_claude/run_onchange_after_generate_mcp-servers.sh.tmpl -> merges into ~/.claude/.claude.json
  Entries may be host-conditional; gate on `stat` of the binary so a machine
  without the app simply omits the server (and picks it up on the next apply).
*/ -}}
{
{{- if stat "/Applications/Fantastical.app/Contents/Helpers/FantasticalMCP.app/Contents/MacOS/FantasticalMCP" }}
  "fantastical": {
    "type": "stdio",
    "command": "/Applications/Fantastical.app/Contents/Helpers/FantasticalMCP.app/Contents/MacOS/FantasticalMCP"
  },
{{- end }}
  "readable": {
    "type": "http",
    "url": "https://readable.page/mcp"
  }
}
